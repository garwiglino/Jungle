class CriqueRouteTest : Actor
{
 void Check(bool result, String label) { Console.Printf("CRIQUE_TEST %s %s",result?"PASS":"FAIL",label); }
 bool Walk(Actor p, Vector2 goal)
 {
  int guard=1000;
  while((goal-p.pos.xy).Length()>2 && guard-->0)
  {
   Vector2 d=goal-p.pos.xy; double len=d.Length(); d*=min(8.,len)/len;
   if(!p.TryMove(p.pos.xy+d,0)) { Console.Printf("BLOCKED %d %d z=%d goal=%d,%d",int(p.pos.x),int(p.pos.y),int(p.pos.z),int(goal.x),int(goal.y)); return false; }
  }
  return guard>0;
 }
 override void PostBeginPlay()
 {
  Super.PostBeginPlay();
  let it=ThinkerIterator.Create("Milicien"); Actor a;
  while(a=Actor(it.Next())) a.Destroy();
  let p=Soldat(players[0].mo); Vector3 initial=p.pos;
  // Both paths traversed with real actor collision and no noclip.
  Check(Walk(p,(2176,1152)) && Walk(p,(1152,1152)) && Walk(p,(1152,4992)) && Walk(p,(2176,4992)) && Walk(p,(2176,5708)),"WEST_ROUTE");
  p.SetOrigin(initial,false);
  Check(Walk(p,(2176,1152)) && Walk(p,(3200,1152)) && Walk(p,(3200,4992)) && Walk(p,(2176,4992)) && Walk(p,(2176,5708)),"EAST_ROUTE");
  p.SetOrigin(initial,false);
  // Sight uses solid map geometry. Foliage sprites do not block sight.
  let guard=Milicien(Spawn("Milicien",(1152,3000,0)));
  p.SetOrigin((1300,3000,0),false); guard.angle=0;
  guard.Tick(); Check(guard.CheckSight(p),"VISIBLE_SAME_CORRIDOR");
  p.SetOrigin((3200,3000,0),false);
  Check(!guard.CheckSight(p),"CENTRAL_MASSIF_OCCLUDES");
  guard.Destroy(); p.SetOrigin(initial,false);
  Destroy();
 }
 States { Spawn: TNT1 A -1; Stop; }
}
